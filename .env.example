# AI Analyst — pick one provider: gemini | openai | deepseek | custom
AI_PROVIDER=gemini

# Shared key (preferred). For Gemini you can still use GEMINI_API_KEY instead.
AI_API_KEY=

# Model id for the chosen provider
AI_MODEL=

# Required for custom; optional override for openai/deepseek
# OpenAI default:  https://api.openai.com/v1
# DeepSeek default: https://api.deepseek.com/v1
# Host-only custom URLs get /v1/chat/completions appended automatically.
AI_BASE_URL=

# Optional: override chat path if your server differs
# Examples: /v1/chat/completions  or  /api/chat/completions
# AI_CHAT_PATH=/v1/chat/completions

# --- Legacy Gemini-only names (still supported) ---
# GEMINI_API_KEY=
# VITE_GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash
